{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/application/**/*.ts",
    "src/infrastructure/audio/playback-model.ts",
    "src/infrastructure/audio/instrument-preview-policy.ts",
    "src/infrastructure/audio/playback-snapshot.ts",
    "src/infrastructure/audio/playback-source.ts",
    "src/infrastructure/audio/time-math.ts",
    "src/infrastructure/audio/worklet/audio-worklet-protocol.ts",
    "src/infrastructure/audio/worklet/polyblep-oscillator.ts",
    "src/infrastructure/audio/worklet/sample-envelope.ts",
    "src/infrastructure/audio/worklet/subtractive-worklet-voice.ts",
    "src/infrastructure/audio/worklet/worklet-held-note-starter.ts",
    "src/infrastructure/audio/worklet/worklet-master-stage.ts",
    "src/infrastructure/audio/worklet/worklet-runtime-instrument.ts",
    "src/infrastructure/audio/worklet/worklet-timeline-engine.ts",
    "src/infrastructure/audio/worklet/worklet-timeline-query.ts",
    "src/infrastructure/audio/worklet/worklet-voice-allocation.ts",
    "src/infrastructure/audio/worklet/worklet-voice-bank.ts",
    "src/domain/**/*.ts",
    "src/editor-core/**/*.ts",
    "src/infrastructure/project-files/**/*.ts"
  ],
  "exclude": [
    "src/**/__tests__/**"
  ]
}
