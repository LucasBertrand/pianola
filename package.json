{
  "name": "piano-roll",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:core && npm run typecheck:ui",
    "typecheck:core": "tsc --project tsconfig.json",
    "typecheck:ui": "tsc --project tsconfig.ui.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.8.0",
    "vite": "^7.3.6"
  }
}
