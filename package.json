{
  "name": "pianola",
  "version": "1.0.0",
  "description": "A touch-first polyphonic piano-roll sequencer for the browser.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "npm run typecheck:core && npm run typecheck:ui && npm run typecheck:test",
    "typecheck:core": "tsc --project tsconfig.json",
    "typecheck:ui": "tsc --project tsconfig.ui.json",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "test": "npm run test:vitest",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:worklet-build": "node scripts/smoke-built-worklet.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "verify": "npm run check:structure && npm run check:boundaries && npm run build && npm run test:worklet-build && npm test"
  },
  "dependencies": {
    "@tonaljs/tonal": "^4.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}